apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root-app
  namespace: argocd 
spec:
  project: default
  source:
    repoURL: {{ argocd_root_url }} 
    targetRevision: HEAD
    # Path within the repo that holds the child Application YAML files
    path: apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true

